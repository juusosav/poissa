@using PoissaHR.Application.Services.EmployeeService
@using PoissaHR.Application.Services.EmployeeDocumentService
@using PoissaHR.Shared.Dto
@using PoissaHR.Helpers

@inject IFileService FileService
@inject IEmployeeService EmployeeService
@inject IEmployeeDocumentService DocumentService
@inject NavigationManager Navigation

@page "/employees/{Id:guid}"

@if (employee == null)
{
    <p>Ladataan työntekijän tietoja...</p>
}
else
{
    <MudGrid Spacing="3">

        <!-- Basic Info -->
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-5 d-flex flex-column" Style="min-height: 17rem;">
                <MudText Typo="Typo.h6">
                    @employee.FirstName @employee.LastName
                </MudText>

                <br />
                <MudText>@employee.Email</MudText>
                <MudText>@employee.Phone</MudText>

                <MudAvatar Size="Size.Large" Class="mt-2">
                    <MudImage Src="@employee.Portrait" Alt="Profiilikuva" />
                </MudAvatar>
                <MudIconButton Class="mt-auto align-self-start"
                               Icon="@Icons.Material.Filled.Edit"
                               title="Muokkaa tietoja"
                               OnClick="@(() => Navigation.NavigateTo($"/employees/{employee.Id}/edit-info"))" />
            </MudPaper>
        </MudItem>

        <!-- Employment -->
        <MudItem xs="12" md="8">
            <MudPaper Class="pa-5 d-flex flex-column" Style="min-height: 17rem;">
                <MudText Typo="Typo.h6">Nykyinen työsuhde</MudText>
                <br />
                @if (employee.CurrentJobTitle != null)
                {
                    <MudText>Osasto: @employee.DepartmentName</MudText>
                    <MudText>Rooli: @employee.CurrentJobTitle</MudText>
                    <br />
                    <MudButton Class="mt-auto align-self-start"
                               OnClick="@(() => Navigation.NavigateTo($"/employees/{employee.Id}/employments"))">
                        Näytä kaikki
                    </MudButton>
                }
                else
                {
                    <MudButton Class="mt-auto align-self-start"
                               OnClick="@(() => Navigation.NavigateTo($"/employees/{employee.Id}/employments/create-employment"))">
                        Lisää työsuhde +
                    </MudButton>
                }
            </MudPaper>
        </MudItem>

        <!-- Tabs -->
        <MudItem xs="12">

            <MudTabs>
                <MudTabPanel Text="Poissaolot">

                    <MudTable Items="@employee.Absences"
                              Hover="true"
                              Bordered="true"
                              Striped="true"
                              Breakpoint="Breakpoint.None">

                        <HeaderContent>
                            <MudTh>Tyyppi</MudTh>
                            <MudTh>Alkupäivä</MudTh>
                            <MudTh>Loppupäivä</MudTh>
                            <MudTh>Status</MudTh>
                            <MudTh>Muistiinpanot</MudTh>
                        </HeaderContent>

                        <RowTemplate Context="absence">
                            <MudTd>@absence.Type</MudTd>
                            <MudTd>@absence.StartDate.ToShortDateString()</MudTd>
                            <MudTd>@absence.EndDate.ToShortDateString()</MudTd>
                            <MudTd>@absence.Status</MudTd>
                            <MudTd>@absence.Notes</MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudTabPanel>
                <MudTabPanel Text="Dokumentit">
                    <MudTable Items="@employee.Documents"
                              Hover="true"
                              Bordered="true"
                              Striped="true"
                              Breakpoint="Breakpoint.None">

                        <HeaderContent>
                            <MudTh>Asiakirjan tyyppi</MudTh>
                            <MudTh>Sisällön tyyppi</MudTh>
                            <MudTh>Tiedostonimi</MudTh>
                        </HeaderContent>

                        <RowTemplate Context="document">
                            <MudTd>@document.DocumentType</MudTd>
                            <MudTd>@document.ContentType</MudTd>
                            <MudTd>@document.FileName</MudTd>
                        </RowTemplate>
                    </MudTable>
                    <br />
                    <MudButton OnClick="NavigateToDocumentCreation"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.PostAdd">
                        Lataa uusi dokumentti
                    </MudButton>
                </MudTabPanel>
                <MudTabPanel Text="Historia">
                    <br />
                </MudTabPanel>
            </MudTabs>
        </MudItem>

    </MudGrid>
}
@code {
    [Parameter]
    public Guid Id { get; set; }

    private EmployeeDto? employee;

    protected override async Task OnInitializedAsync()
    {
        employee = await EmployeeService.GetEmployeeByIdAsync(Id);
    }

    private void NavigateToDocumentCreation() => Navigation.NavigateTo($"/employees/{Id}/create-document");
}
