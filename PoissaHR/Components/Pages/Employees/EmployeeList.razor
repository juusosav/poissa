@using PoissaHR.Application.Services.EmployeeService
@using PoissaHR.Shared.Dto

@inject IEmployeeService EmployeeService
@inject NavigationManager Navigation

@page "/employees"

<PageTitle>Employee List</PageTitle>

<MudPaper Class="pa-4">
    <MudText Class="d-flex justify-space-between" Typo="Typo.h5" GutterBottom="true">
        Työntekijät
        <MudButton OnClick="NavigateToCreateEmployee">
            <MudIcon Icon="@Icons.Material.Filled.Add" />
            Lisää uusi työntekijä
        </MudButton>
    </MudText>
    @if (employees == null || !employees.Any())
    {
        <p>Ladataan työntekijälistaa...</p>
    }
    else
    {
        <EmployeeListCard Employees="employees" />
    }
</MudPaper>


@code {
    private List<EmployeeDto> employees = new();

    protected override async Task OnInitializedAsync()
    {
        var employeeList = await EmployeeService.GetAllEmployeesAsync();
        employees = employeeList.ToList();
    }

    private void NavigateToCreateEmployee() => Navigation.NavigateTo("/employees/create-employee");
}