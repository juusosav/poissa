@using PoissaHR.Application.Services.DepartmentService
@using PoissaHR.Application.Services.EmployeeService
@using PoissaHR.Shared.Dto

@inject IEmployeeService EmployeeService
@inject IDepartmentService DepartmentService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

@rendermode InteractiveServer

@page "/employees/create-employee"

<MudPaper Class="pa-4">
    <MudText Typo="Typo.h5" GutterBottom="true">
        Luo uusi työntekijä
    </MudText>

    <MudForm @ref="_form">
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudSelect Placeholder="Valitse osasto"
                           T="Guid?"
                           Label="Osasto"
                           @bind-Value="_selectedDepartmentId"
                           Required="true">
                    @foreach (var dept in departments)
                    {
                        <MudSelectItem T="Guid?" Value="@dept.Id">@dept.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField Label="Etunimi"
                              @bind-Value="model.FirstName"
                              Required="true" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField Label="Sukunimi"
                              @bind-Value="model.LastName"
                              Required="true" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudText>Kuva</MudText>
                <MudFileUpload T="IBrowserFile"
                               FilesChanged="OnFileSelected"
                               Accept="image/*">
                    <ActivatorContent>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.CloudUpload">
                            Lataa kuva
                        </MudButton>
                    </ActivatorContent>
                </MudFileUpload>

            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField Label="Sähköposti"
                              @bind-Value="model.Email"
                              Required="true" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField Label="Puhelinnumero"
                              @bind-Value="model.Phone"
                              Required="true" />
            </MudItem>
        </MudGrid>

        <MudStack Row="true" Spacing="2" Class="mt-4">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="HandleValidSubmit">
                Tallenna uusi työntekijä
            </MudButton>

            <MudButton Variant="Variant.Outlined"
                       OnClick="Cancel">
                Peruuta
            </MudButton>
        </MudStack>
    </MudForm>
</MudPaper>


@code {
    private EmployeeCreateDto model = new();
    private MudForm? _form;

    private IBrowserFile? _portraitImage;

    [Inject] IWebHostEnvironment Environment { get; set; } = default!;

    private Guid? _selectedDepartmentId;

    private List<DepartmentDto> departments = new();

    protected override async Task OnInitializedAsync()
    {
        departments = (await DepartmentService.GetAllDepartmentsAsync()).ToList();
    }

    private async Task OnFileSelected(IBrowserFile file)
    {
        _portraitImage = file;
    }

    public async Task HandleValidSubmit()
    {
        if (_form == null)
            return;

        await _form.Validate();

        if (!_form.IsValid)
            return;

        if (_portraitImage != null)
        {
            Console.WriteLine($"Upload started for file: {_portraitImage.Name}");

            var uploadsFolder = Path.Combine(
            Environment.WebRootPath,
            "uploads");

            Directory.CreateDirectory(uploadsFolder);

            var fileName =
            $"{Guid.NewGuid()}{Path.GetExtension(_portraitImage.Name)}";

            var filePath = Path.Combine(uploadsFolder, fileName);

            await using var stream =
            new FileStream(filePath, FileMode.Create);

            try
            {
                await _portraitImage.OpenReadStream(5 * 1024 * 1024)
                .CopyToAsync(stream);
            }
            catch (Exception ex)
            {
                Console.WriteLine(ex);
                Snackbar.Add($"Virhe: {ex.Message}", Severity.Error);
                throw;
            }

            Console.WriteLine($"WebRootPath: {Environment.WebRootPath}");
            Console.WriteLine($"ContentRootPath: {Environment.ContentRootPath}");

            model.Portrait = $"/uploads/{fileName}";
        }

        if (_selectedDepartmentId != null)
        {
            model.DepartmentId = _selectedDepartmentId.Value;
        }

        try
        {
            var created = await EmployeeService.CreateEmployeeAsync(model);
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            throw;
        }

        Snackbar.Add("Työntekijän lisätty onnistuneesti", Severity.Success);

        Navigation.NavigateTo("/employees");
    }

    private void Cancel() => Navigation.NavigateTo($"/employees");
}