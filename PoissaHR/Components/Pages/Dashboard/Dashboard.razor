@using PoissaHR.Application.Services.DashboardService
@using PoissaHR.Shared.Dto

@inject IDashboardService DashboardService

@page "/"

<PageTitle>Koti</PageTitle>

<MudPaper Class="d-flex">
    <MudContainer Style="text-align: center;">
        <br />
        <MudText Typo="Typo.h4" GutterBottom="true">Tervetuloa PoissaHR-järjestelmään!</MudText>
        <br />

        <MudGrid Spacing="3">
            <MudItem xs="12" md="4">
                <MudPaper Class="pa-4">
                    <MudText Typo="Typo.body1">
                        <strong>Työntekijät</strong>
                        <br />
                        <MudText>@dashboardData?.EmployeeCount</MudText>
                    </MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudPaper Class="pa-4">
                    <MudText Typo="Typo.body1">
                        <strong>Osastot</strong>
                        <br />
                        <MudText>@dashboardData?.DepartmentCount</MudText>
                    </MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="4">
                <MudPaper Class="pa-4">
                    <MudText Typo="Typo.body1">
                        <strong>Poissaoloja tänään</strong>
                        <br />
                        <MudText>@dashboardData?.AbsenceCount</MudText>
                    </MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudPaper Class="pa-4">
                    <MudText Typo="Typo.body1">
                        <strong>Tulevat lomat</strong>
                        <br />
                        <MudText>@dashboardData?.UpcomingVacationsCount</MudText>
                    </MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>
        <br />
    </MudContainer>
</MudPaper>

@code {
    private DashboardDto? dashboardData = new();

    protected override async Task OnInitializedAsync()
    {
        var data = await DashboardService.GetDashboardAsync();
        dashboardData = data;
    }
}
