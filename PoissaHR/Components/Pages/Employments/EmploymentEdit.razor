@using PoissaHR.Application.Services.EmploymentService
@using PoissaHR.Shared.Dto
@using PoissaHR.Domain.Enums
@using PoissaHR.Shared.Extensions

@inject IEmploymentService EmploymentService
@inject NavigationManager Navigation

@page "/employees/{Id:guid}/employments/{EmploymentId:guid}"

@if (model == null)
{
    <p>Ladataan työsuhteen tietoja...</p>
}
else
{
    <MudPaper Class="pa-4">
        <MudText Typo="Typo.h5" GutterBottom="true">
            Muokkaa työsuhteen tietoja
        </MudText>

        <MudForm @ref="_form">
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField Label="Titteli"
                                  @bind-Value="model.JobTitle"
                                  Required="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="EmploymentStatus"
                               Label="Status"
                               @bind-Value="model.Status"
                               Required="true">
                        @foreach (var status in _statuses)
                        {
                            <MudSelectItem Value="@status">
                                @status.GetDisplayName()
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="EmploymentType"
                               Label="Tyyppi"
                               @bind-Value="model.Type"
                               Required="true">
                        @foreach (var type in _types)
                        {
                            <MudSelectItem Value="@type">
                                @type.GetDisplayName()
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

            </MudGrid>

        </MudForm>
        <MudStack Row="true" Spacing="2" Class="mt-4">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="Save">
                Tallenna
            </MudButton>

            <MudButton Variant="Variant.Outlined"
                       OnClick="Cancel">
                Peruuta
            </MudButton>
        </MudStack>
    </MudPaper>


}
@code {
    [Parameter]
    public Guid Id { get; set; }

    [Parameter]
    public Guid EmploymentId { get; set; }

    private readonly EmploymentStatus[] _statuses =
        Enum.GetValues<EmploymentStatus>();

    private readonly EmploymentType[] _types =
        Enum.GetValues<EmploymentType>();

    private EmploymentEditDto model = new();
    MudForm? _form;

    protected override async Task OnInitializedAsync()
    {
        var employment = await EmploymentService.GetEmploymentForEditAsync(EmploymentId);

        if (employment == null)
        {
            Navigation.NavigateTo("/employees");
            return;
        }

        model = employment;
    }

    private void Cancel() => Navigation.NavigateTo($"/employees/{Id}/employments");

    private void Save()
    {
        if (_form == null)
        {
            return;
        }

        _form.Validate();
        if (!_form.IsValid)
        {
            return;
        }

        EmploymentService.UpdateEmploymentAsync(model);
        Navigation.NavigateTo($"/employees/{Id}/employments");
    }
}
