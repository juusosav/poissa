@using PoissaHR.Application.Services.EmploymentService
@using PoissaHR.Shared.Dto
@using PoissaHR.Shared.Extensions

@inject IEmploymentService EmploymentService
@inject NavigationManager Navigation

@page "/employees/{Id:guid}/employments"

@if (employments == null || !employments.Any())
{
    <p>Ladataan työsuhdelistaa...</p>
}
else
{
    <MudPaper Class="pa-4">
        <MudItem>
            <MudButton OnClick="BackToEmployee">
                ⬅ Takaisin työntekijään
            </MudButton>
        </MudItem>

        <MudTable Items="@employments"
                  Hover="true"
                  Striped="true"
                  Bordered="true"
                  Breakpoint="Breakpoint.None">
            <HeaderContent>
                <MudTh>Titteli</MudTh>
                <MudTh>Tyyppi</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Aloituspäivä</MudTh>
                <MudTh>Päättymispäivä</MudTh>
            </HeaderContent>

            <RowTemplate>
                <MudTd>@context.JobTitle</MudTd>
                <MudTd>@context.Type.GetDisplayName()</MudTd>
                <MudTd>@context.Status.GetDisplayName()</MudTd>
                <MudTd>@context.StartDate.ToString("dd:MM:yyyy")</MudTd>
                <MudTd>@context.EndDate?.ToString("dd:MM:yyyy")</MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="@(() => GoToDetails(context.Id))" />
                </MudTd>
            </RowTemplate>
        </MudTable>

    </MudPaper>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private List<EmploymentDto> employments = new();

    protected override async Task OnInitializedAsync()
    {
        var employmentList = await EmploymentService.GetEmploymentsByEmployeeIdAsync(Id);
        employments = employmentList.ToList();
    }

    private void GoToDetails(Guid employmentId) => Navigation.NavigateTo($"/employees/{Id}/employments/{employmentId}");

    private void BackToEmployee() => Navigation.NavigateTo($"/employees/{Id}");
}
